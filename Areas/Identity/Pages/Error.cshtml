@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle auth-icono text-danger"></i>
    <h1 class="h3 fw-bold mt-3">Ocurrió un error</h1>
    <p class="text-secondary">No pudimos procesar tu solicitud. Probá de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-secondary">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-dark" asp-area="" asp-controller="Home" asp-action="Index">Ir al inicio</a>
</div>
