@using Microsoft.AspNetCore.Authentication
@model (IList<AuthenticationScheme>? Proveedores, string? ReturnUrl)

@* Botones "Continuar con Google" (y cualquier otro proveedor externo), usados en Login y Registro. *@
@if ((Model.Proveedores?.Count ?? 0) > 0)
{
    <div class="login-divider my-4"><span>o</span></div>

    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        @foreach (var provider in Model.Proveedores!)
        {
            <button type="submit" class="btn btn-outline-dark btn-lg w-100 mb-2" name="provider" value="@provider.Name" title="Ingresar con tu cuenta de @provider.DisplayName">
                @if (provider.Name == "Google")
                {
                    <i class="bi bi-google me-1"></i>
                }
                Continuar con @provider.DisplayName
            </button>
        }
    </form>
}
