@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";
}

<form id="account" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
        <label asp-for="Input.Email"><i class="bi bi-envelope me-1"></i> Email</label>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="contraseña" />
        <label asp-for="Input.Password"><i class="bi bi-lock me-1"></i> Contraseña</label>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label" asp-for="Input.RememberMe">Recordarme</label>
        </div>
        <a id="forgot-password" class="login-link small" asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
    </div>

    <button id="login-submit" type="submit" class="btn btn-dark btn-lg w-100">
        <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar
    </button>
</form>

<partial name="_ExternalLoginButtons" model="(Model.ExternalLogins, Model.ReturnUrl)" />

<div class="text-center mt-4 small">
    <p class="mb-1">
        ¿No tenés cuenta?
        <a class="login-link fw-semibold" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registrate</a>
    </p>
    <p class="mb-0">
        <a id="resend-confirmation" class="login-link text-secondary" asp-page="./ResendEmailConfirmation">Reenviar email de confirmación</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
