@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configurar app de autenticación";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="h5 fw-bold mb-3">@ViewData["Title"]</h2>
<div>
    <p>Para usar una app de autenticación seguí estos pasos:</p>
    <ol class="list">
        <li>
            <p>
                Descargá una app de autenticación, como Microsoft Authenticator para
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> e
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a>, o
                Google Authenticator para
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=es">Android</a> e
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
            </p>
        </li>
        <li>
            <p>Escaneá el código QR o ingresá esta clave <kbd>@Model.SharedKey</kbd> en la app. No importan los espacios ni las mayúsculas.</p>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                Una vez que escaneaste el código QR o ingresaste la clave, la app te va a mostrar un código.
                Ingresalo acá abajo para confirmar.
            </p>
            <div class="row">
                <div class="col-lg-8">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="código" />
                            <label asp-for="Input.Code"><i class="bi bi-shield-check me-1"></i> Código de verificación</label>
                            <span asp-validation-for="Input.Code" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-dark btn-lg w-100">Verificar</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger mt-2" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
