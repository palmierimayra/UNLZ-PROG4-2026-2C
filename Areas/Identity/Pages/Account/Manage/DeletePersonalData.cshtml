@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Eliminar cuenta";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="h5 fw-bold mb-3">@ViewData["Title"]</h2>

<div class="alert alert-danger" role="alert">
    <strong>Esto borra tu cuenta para siempre y no se puede deshacer.</strong>
</div>

<div class="row">
    <div class="col-lg-8">
        <form id="delete-user" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            @if (Model.RequirePassword)
            {
                <div class="form-floating mb-4">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="contraseña" />
                    <label asp-for="Input.Password"><i class="bi bi-lock me-1"></i> Contraseña</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
            }
            <button class="btn btn-danger btn-lg w-100" type="submit">Eliminar mis datos y cerrar la cuenta</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
