@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h2 class="h5 fw-bold mb-3">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-lg-8">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="usuario" disabled />
                <label asp-for="Username">Usuario</label>
            </div>
            <div class="form-floating mb-4">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="teléfono" />
                <label asp-for="Input.PhoneNumber"><i class="bi bi-telephone me-1"></i> Teléfono</label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
            </div>
            <button id="update-profile-button" type="submit" class="btn btn-dark btn-lg w-100">Guardar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
