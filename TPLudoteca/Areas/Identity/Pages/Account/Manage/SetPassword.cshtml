@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Crear contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="h5 fw-bold mb-3">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<p class="text-secondary">
    Tu cuenta no tiene contraseña porque ingresás con una cuenta externa (por ejemplo, Google).
    Creá una para poder ingresar también con tu email y contraseña.
</p>
<div class="row">
    <div class="col-lg-8">
        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="nueva contraseña" />
                <label asp-for="Input.NewPassword"><i class="bi bi-lock me-1"></i> Nueva contraseña</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="confirmar contraseña" />
                <label asp-for="Input.ConfirmPassword"><i class="bi bi-lock-fill me-1"></i> Confirmar contraseña</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-dark btn-lg w-100">Crear contraseña</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
