@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Códigos de recuperación";
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<partial name="_StatusMessage" for="StatusMessage" />
<h2 class="h5 fw-bold mb-3">@ViewData["Title"]</h2>
<div class="alert alert-warning" role="alert">
    <p><strong>Guardá estos códigos en un lugar seguro.</strong></p>
    <p class="mb-0">Si perdés tu dispositivo y no tenés los códigos de recuperación, vas a perder el acceso a tu cuenta.</p>
</div>
<div class="row">
    <div class="col-md-12">
        @for (var row = 0; row < (Model.RecoveryCodes?.Length ?? 0); row += 2)
        {
            <code class="recovery-code">@Model.RecoveryCodes![row]</code><text>&nbsp;</text><code class="recovery-code">@Model.RecoveryCodes[row + 1]</code><br />
        }
    </div>
</div>
