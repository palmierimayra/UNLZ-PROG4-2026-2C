@page
@model LockoutModel
@{
    ViewData["Title"] = "Cuenta bloqueada";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <i class="bi bi-lock auth-icono text-danger"></i>
    <p class="mt-3">Tu cuenta está bloqueada y no podés iniciar sesión. Si creés que es un error, comunicate con un administrador.</p>
    <a class="btn btn-dark w-100" asp-page="./Login">Volver a iniciar sesión</a>
</div>
