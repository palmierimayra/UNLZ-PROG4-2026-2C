@page
@model LogoutModel
@{
    ViewData["Title"] = "Cerrar sesión";
    Layout = "_AuthLayout";
}

<div class="text-center">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <p>¿Querés cerrar tu sesión?</p>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
            <button type="submit" class="btn btn-dark w-100"><i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión</button>
        </form>
    }
    else
    {
        <i class="bi bi-door-open auth-icono"></i>
        <p class="mt-3">Cerraste sesión correctamente.</p>
        <a class="btn btn-dark w-100" asp-page="./Login">Iniciar sesión</a>
    }
</div>
