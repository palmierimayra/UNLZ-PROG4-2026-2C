@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
    ViewData["Subtitle"] = "Ingresá tu email y te enviamos un link para restablecerla.";
    Layout = "_AuthLayout";
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="form-floating mb-4">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
        <label asp-for="Input.Email"><i class="bi bi-envelope me-1"></i> Email</label>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-dark btn-lg w-100">
        <i class="bi bi-send me-1"></i> Enviar link
    </button>
</form>

<div class="text-center mt-4 small">
    <a class="login-link" asp-page="./Login"><i class="bi bi-arrow-left me-1"></i> Volver a iniciar sesión</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
