@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Verificación en dos pasos";
    ViewData["Subtitle"] = "Ingresá el código de tu app de autenticación.";
    Layout = "_AuthLayout";
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <input asp-for="RememberMe" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" placeholder="123456" />
        <label asp-for="Input.TwoFactorCode"><i class="bi bi-shield-check me-1"></i> Código</label>
        <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" asp-for="Input.RememberMachine" />
        <label class="form-check-label" asp-for="Input.RememberMachine">Recordar este dispositivo</label>
    </div>

    <button type="submit" class="btn btn-dark btn-lg w-100">
        <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar
    </button>
</form>

<div class="text-center mt-4 small">
    ¿No tenés acceso a tu app de autenticación?
    <a id="recovery-code-login" class="login-link fw-semibold" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Usá un código de recuperación</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
