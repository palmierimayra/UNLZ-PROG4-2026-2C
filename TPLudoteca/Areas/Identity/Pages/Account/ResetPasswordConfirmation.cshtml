@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña restablecida";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <i class="bi bi-check-circle auth-icono text-success"></i>
    <p class="mt-3">Tu contraseña se cambió correctamente.</p>
    <a class="btn btn-dark w-100" asp-page="./Login">Iniciar sesión</a>
</div>
