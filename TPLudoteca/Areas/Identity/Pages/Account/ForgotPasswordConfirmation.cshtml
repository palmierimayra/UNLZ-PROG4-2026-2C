@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Revisá tu email";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <i class="bi bi-envelope-check auth-icono"></i>
    <p class="mt-3">Te enviamos un email con un link para restablecer tu contraseña.</p>
    <a class="btn btn-dark w-100" asp-page="./Login">Volver a iniciar sesión</a>
</div>
