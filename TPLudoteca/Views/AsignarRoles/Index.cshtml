@using System.Security.Claims
@model IEnumerable<TPLudoteca.Models.UsuarioRolVM>
@{
    ViewData["Title"] = "Asignación de roles";
    var idUsuarioActual = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="toastMensaje" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle me-1"></i> @mensaje
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>
}

<div class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-0">Asignación de roles</h1>
        </div>
    </div>

    <div class="card manage-card shadow-sm">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-secondary py-5">
                    <i class="bi bi-people auth-icono"></i>
                    <p class="mt-3 mb-0">Todavía no hay usuarios registrados.</p>
                </div>
            }
            else
            {
                <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="input-group buscador-usuarios">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="search" id="buscadorUsuarios" class="form-control" placeholder="Buscar por email" aria-label="Buscar usuarios" autocomplete="off" />
                    </div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Email</th>
                                <th>Rol</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaUsuarios">
                            @foreach (var usuario in Model)
                            {
                                <tr class="@(usuario.Desactivado ? "text-secondary" : "")">
                                    <td class="ps-4">
                                        @usuario.Email
                                        @if (usuario.Desactivado)
                                        {
                                            <span class="badge text-bg-danger ms-1">Desactivado</span>
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrEmpty(usuario.Rol))
                                        {
                                            <span class="badge text-bg-light border">Sin rol</span>
                                        }
                                        else if (usuario.Rol == "Administrador")
                                        {
                                            <span class="badge text-bg-dark">@usuario.Rol</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">@usuario.Rol</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 text-nowrap">
                                        <a asp-action="Editar" asp-route-id="@usuario.IdUsuario" class="btn btn-sm btn-outline-dark" title="Asignar rol">
                                            <i class="bi bi-person-gear"></i>
                                        </a>
                                        @if (usuario.IdUsuario != idUsuarioActual)
                                        {
                                            if (usuario.Desactivado)
                                            {
                                                <form asp-action="CambiarEstado" asp-route-id="@usuario.IdUsuario" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivar usuario">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" title="Desactivar usuario"
                                                        data-bs-toggle="modal" data-bs-target="#modalDesactivar"
                                                        data-url="@Url.Action("CambiarEstado", new { id = usuario.IdUsuario })"
                                                        data-email="@usuario.Email"
                                                        data-rol="@(string.IsNullOrEmpty(usuario.Rol) ? "Sin rol" : usuario.Rol)">
                                                    <i class="bi bi-person-slash"></i>
                                                </button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            <tr id="sinResultados" class="d-none">
                                <td colspan="3" class="text-center text-secondary py-4">No se encontraron usuarios.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="modalDesactivar" tabindex="-1" aria-labelledby="modalDesactivarTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content manage-card shadow">
            <form id="formDesactivar" asp-action="CambiarEstado" method="post">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h5 fw-bold" id="modalDesactivarTitulo"><i class="bi bi-person-slash me-2"></i>Desactivar usuario</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Seguro que querés desactivar este usuario?</p>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8" id="modalEmail"></dd>

                        <dt class="col-sm-4">Rol</dt>
                        <dd class="col-sm-8" id="modalRol"></dd>
                    </dl>
                    <div class="alert alert-info small mt-3 mb-0" role="alert">
                        <i class="bi bi-info-circle me-1"></i>
                        No va a poder iniciar sesión hasta que lo reactives. Sus datos y su historial de alquileres se conservan.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-person-slash me-1"></i> Desactivar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const toastMensaje = document.getElementById('toastMensaje');
        if (toastMensaje) {
            bootstrap.Toast.getOrCreateInstance(toastMensaje).show();
        }

        const modalDesactivar = document.getElementById('modalDesactivar');
        modalDesactivar.addEventListener('show.bs.modal', evento => {
            const boton = evento.relatedTarget;
            document.getElementById('formDesactivar').action = boton.dataset.url;
            document.getElementById('modalEmail').textContent = boton.dataset.email;
            document.getElementById('modalRol').textContent = boton.dataset.rol;
        });

        const buscador = document.getElementById('buscadorUsuarios');
        if (buscador) {
            const filas = document.querySelectorAll('#tablaUsuarios tr:not(#sinResultados)');
            const sinResultados = document.getElementById('sinResultados');

            buscador.addEventListener('input', () => {
                const texto = buscador.value.trim().toLowerCase();
                let visibles = 0;

                filas.forEach(fila => {
                    const coincide = fila.textContent.toLowerCase().includes(texto);
                    fila.classList.toggle('d-none', !coincide);
                    if (coincide) {
                        visibles++;
                    }
                });

                sinResultados.classList.toggle('d-none', visibles > 0);
            });
        }
    </script>
}
