@model IEnumerable<TPLudoteca.Models.JuegoVM>
@{
    ViewData["Title"] = "Juegos";
}

@if (TempData["Error"] is string error)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="toastMensaje" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-exclamation-circle me-1"></i> @error
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>
}
else if (TempData["Mensaje"] is string mensaje)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="toastMensaje" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle me-1"></i> @mensaje
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>
}

<div class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-0">Juegos</h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
            <a asp-action="Crear" class="btn btn-dark">
                <i class="bi bi-plus-circle me-1"></i> Agregar nuevo juego
            </a>
        </div>
    </div>

    <div class="card manage-card shadow-sm">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-secondary py-5">
                    <i class="bi bi-controller auth-icono"></i>
                    <p class="mt-3 mb-0">Todavía no hay juegos cargados.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">@Html.DisplayNameFor(m => m.DescripcionJuego)</th>
                                <th>Categoría</th>
                                <th class="text-end">@Html.DisplayNameFor(m => m.MontoAlquiler)</th>
                                <th class="text-center">@Html.DisplayNameFor(m => m.Disponible)</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var juego in Model)
                            {
                                <tr>
                                    <td class="ps-4">@juego.DescripcionJuego</td>
                                    <td>
                                        <span class="badge text-bg-secondary">@(juego.CategoriaJuegoVM?.DescripcionCategoria ?? juego.IdCategoriaJuego.ToString())</span>
                                    </td>
                                    <td class="text-end">@(juego.MontoAlquiler.HasValue ? "$ " + juego.MontoAlquiler.Value.ToString("N2") : "-")</td>
                                    <td class="text-center">
                                        <span class="badge @(juego.Disponible > 0 ? "text-bg-success" : "text-bg-danger")">@juego.Disponible de @juego.Cantidad</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Editar" asp-route-id="@juego.IdJuego" class="btn btn-sm btn-outline-dark" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Eliminar" asp-route-id="@juego.IdJuego" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const toastMensaje = document.getElementById('toastMensaje');
        if (toastMensaje) {
            bootstrap.Toast.getOrCreateInstance(toastMensaje).show();
        }
    </script>
}
