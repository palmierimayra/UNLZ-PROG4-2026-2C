@model IEnumerable<TPLudoteca.Models.AlquilerVM>
@{
    ViewData["Title"] = "Mis alquileres";
}

@if (TempData["Error"] is string error)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="toastMensaje" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-exclamation-circle me-1"></i> @error
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>
}
else if (TempData["Mensaje"] is string mensaje)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="toastMensaje" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle me-1"></i> @mensaje
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>
}

<div class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 fw-bold mb-0">Mis alquileres</h1>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
            <a asp-action="Crear" class="btn btn-dark">
                <i class="bi bi-bag-plus me-1"></i> Alquilar un juego
            </a>
        </div>
    </div>

    <div class="card manage-card shadow-sm">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center text-secondary py-5">
                    <i class="bi bi-clock-history auth-icono"></i>
                    <p class="mt-3 mb-0">Todavía no alquilaste ningún juego.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Juego</th>
                                <th>Retiro</th>
                                <th>Devolución</th>
                                <th>Estado</th>
                                <th class="text-end">Monto</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alquiler in Model)
                            {
                                var enCurso = alquiler.FechaDevolucionReal == null && DateTime.Today <= alquiler.FechaDevolucionEstimada.Date;
                                <tr>
                                    <td class="ps-4">@alquiler.JuegoVM?.DescripcionJuego</td>
                                    <td>@alquiler.FechaRetiro.ToString("dd/MM/yyyy")</td>
                                    <td>@((alquiler.FechaDevolucionReal ?? alquiler.FechaDevolucionEstimada).ToString("dd/MM/yyyy"))</td>
                                    <td>
                                        @if (alquiler.FechaDevolucionReal != null)
                                        {
                                            <span class="badge text-bg-secondary">Devuelto</span>
                                        }
                                        else if (!enCurso)
                                        {
                                            <span class="badge text-bg-danger">Vencido</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">En curso</span>
                                        }
                                    </td>
                                    <td class="text-end">$ @alquiler.MontoTotal.ToString("N2")</td>
                                    <td class="text-end pe-4 text-nowrap">
                                        <a asp-action="Detalle" asp-route-id="@alquiler.IdAlquiler" class="btn btn-sm btn-outline-dark" title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (enCurso)
                                        {
                                            <a asp-action="Editar" asp-route-id="@alquiler.IdAlquiler" class="btn btn-sm btn-outline-dark" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Eliminar" asp-route-id="@alquiler.IdAlquiler" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const toastMensaje = document.getElementById('toastMensaje');
        if (toastMensaje) {
            bootstrap.Toast.getOrCreateInstance(toastMensaje).show();
        }
    </script>
}
