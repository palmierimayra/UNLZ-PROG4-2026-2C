@model TPLudoteca.Models.AlquilerVM
@{
    ViewData["Title"] = "Editar alquiler";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card manage-card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 fw-bold mb-4"><i class="bi bi-pencil me-2"></i>Editar alquiler</h1>

                <form asp-action="Editar" asp-route-id="@Model.IdAlquiler" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="IdAlquiler" />

                    <div class="form-floating mb-3">
                        <select asp-for="IdJuego" asp-items="ViewBag.Juegos" class="form-select"></select>
                        <label asp-for="IdJuego">Juego</label>
                        <span asp-validation-for="IdJuego" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="FechaRetiro" type="date" asp-format="{0:yyyy-MM-dd}" min="@ViewBag.FechaRetiroMinima" max="@ViewBag.FechaRetiroMaxima" class="form-control" />
                        <label asp-for="FechaRetiro">Fecha de retiro</label>
                        <span asp-validation-for="FechaRetiro" class="text-danger small"></span>
                    </div>

                    <p class="text-secondary small mb-4">
                        <i class="bi bi-info-circle me-1"></i>
                        La devolución estimada se calcula sola: @ViewBag.DiasDePlazo días después de la fecha de retiro. Si cambiás de juego, el monto pasa a ser el del juego nuevo.
                    </p>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-dark w-50">Cancelar</a>
                        <button type="submit" class="btn btn-dark w-50">
                            <i class="bi bi-check2 me-1"></i> Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
