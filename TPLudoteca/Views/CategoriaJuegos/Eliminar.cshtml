@model TPLudoteca.Models.CategoriaJuegoVM
@{
    ViewData["Title"] = "Eliminar categoría";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card manage-card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 fw-bold mb-3"><i class="bi bi-trash me-2"></i>Eliminar categoría</h1>
                <p class="text-secondary mb-4">¿Seguro que querés eliminar esta categoría?</p>

                <dl class="row mb-4">
                    <dt class="col-sm-5">Descripción</dt>
                    <dd class="col-sm-7">@Model.DescripcionCategoria</dd>
                </dl>

                <form asp-action="Eliminar" method="post">
                    <input type="hidden" asp-for="IdCategoriaJuego" />
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-dark w-50">Cancelar</a>
                        <button type="submit" class="btn btn-danger w-50">
                            <i class="bi bi-trash me-1"></i> Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
