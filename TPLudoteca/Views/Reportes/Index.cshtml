@model TPLudoteca.Models.ReporteTiendaVM
@{
    ViewData["Title"] = "Reportería";
    var porcentajeOcupacion = Model.CopiasTotales > 0 ? (decimal)Model.CopiasAlquiladas * 100 / Model.CopiasTotales : 0;
    var hayAlquileres = Model.TotalAlquileres > 0;
}

<div class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 fw-bold mb-0">Reportería</h1>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
            <a asp-action="ListadoTransacciones" class="btn btn-dark">
                <i class="bi bi-journal-text me-1"></i> Maestro de alquileres
            </a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-secondary small">Socios</span>
                        <i class="bi bi-people fs-4 text-secondary"></i>
                    </div>
                    <div class="h3 fw-bold mb-0">@Model.CantidadSocios</div>
                    <span class="small text-success">@Model.SociosActivos activos</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-secondary small">Juegos</span>
                        <i class="bi bi-controller fs-4 text-secondary"></i>
                    </div>
                    <div class="h3 fw-bold mb-0">@Model.CantidadJuegos</div>
                    <span class="small text-secondary">@Model.CopiasTotales copias en total</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-secondary small">Copias alquiladas</span>
                        <i class="bi bi-bag-check fs-4 text-secondary"></i>
                    </div>
                    <div class="h3 fw-bold mb-0">@Model.CopiasAlquiladas</div>
                    <span class="small text-secondary">@porcentajeOcupacion.ToString("N0")% de ocupación</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-secondary small">Alquileres vencidos</span>
                        <i class="bi bi-exclamation-triangle fs-4 @(Model.AlquileresVencidos > 0 ? "text-danger" : "text-secondary")"></i>
                    </div>
                    <div class="h3 fw-bold mb-0 @(Model.AlquileresVencidos > 0 ? "text-danger" : "")">@Model.AlquileresVencidos</div>
                    <span class="small text-secondary">sin devolver y fuera de plazo</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-secondary small">Juego más alquilado</span>
                        <i class="bi bi-trophy fs-4 text-secondary"></i>
                    </div>
                    <div class="h5 fw-bold mb-0 text-truncate" title="@Model.JuegoMasAlquilado">@(Model.JuegoMasAlquilado ?? "-")</div>
                    <span class="small text-secondary">@Model.VecesJuegoMasAlquilado alquileres</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-secondary small">Socios con alquiler en curso</span>
                        <i class="bi bi-person-check fs-4 text-secondary"></i>
                    </div>
                    <div class="h3 fw-bold mb-0">@Model.SociosConAlquilerEnCurso</div>
                    <span class="small text-secondary">de @Model.SociosActivos socios activos</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-secondary small">Ingresos del mes</span>
                        <i class="bi bi-cash-coin fs-4 text-secondary"></i>
                    </div>
                    <div class="h3 fw-bold mb-0">$ @Model.IngresosDelMes.ToString("N2")</div>
                    <span class="small text-secondary">alquileres retirados este mes</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-secondary small">Recaudado por mora</span>
                        <i class="bi bi-hourglass-split fs-4 text-secondary"></i>
                    </div>
                    <div class="h3 fw-bold mb-0">$ @Model.RecaudadoPorMora.ToString("N2")</div>
                    <span class="small text-secondary">en devoluciones con demora</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 fw-bold mb-3">Alquileres por categoría</h2>
                    @if (hayAlquileres)
                    {
                        <div class="grafico-contenedor">
                            <canvas id="graficoCategorias"></canvas>
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary text-center py-5 mb-0">Todavía no hay alquileres.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card manage-card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 fw-bold mb-3">Juegos más alquilados</h2>
                    @if (hayAlquileres)
                    {
                        <div class="grafico-contenedor">
                            <canvas id="graficoTopJuegos"></canvas>
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary text-center py-5 mb-0">Todavía no hay alquileres.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card manage-card shadow-sm">
                <div class="card-body">
                    <h2 class="h6 fw-bold mb-3">Alquileres de los últimos 6 meses</h2>
                    <div class="grafico-contenedor">
                        <canvas id="graficoMeses"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const colores = ['#212529', '#e31b23', '#6c757d', '#adb5bd', '#f28b8f', '#495057', '#ced4da', '#8b0f14'];
        Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
        Chart.defaults.color = '#495057';

        const categorias = @Json.Serialize(Model.CategoriasNombres);
        const cantidadesPorCategoria = @Json.Serialize(Model.CategoriasCantidades);
        const graficoCategorias = document.getElementById('graficoCategorias');
        if (graficoCategorias) {
            const total = cantidadesPorCategoria.reduce((suma, valor) => suma + valor, 0);
            new Chart(graficoCategorias, {
                type: 'doughnut',
                data: {
                    labels: categorias,
                    datasets: [{ data: cantidadesPorCategoria, backgroundColor: colores, borderWidth: 2 }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: contexto => `${contexto.label}: ${contexto.parsed} (${(contexto.parsed * 100 / total).toFixed(1)}%)`
                            }
                        }
                    }
                }
            });
        }

        const graficoTopJuegos = document.getElementById('graficoTopJuegos');
        if (graficoTopJuegos) {
            new Chart(graficoTopJuegos, {
                type: 'bar',
                data: {
                    labels: @Json.Serialize(Model.TopJuegosNombres),
                    datasets: [{ label: 'Alquileres', data: @Json.Serialize(Model.TopJuegosCantidades), backgroundColor: '#212529', borderRadius: 6 }]
                },
                options: {
                    indexAxis: 'y',
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }

        new Chart(document.getElementById('graficoMeses'), {
            type: 'line',
            data: {
                labels: @Json.Serialize(Model.MesesNombres),
                datasets: [{
                    label: 'Alquileres',
                    data: @Json.Serialize(Model.MesesCantidades),
                    borderColor: '#e31b23',
                    backgroundColor: 'rgba(227, 27, 35, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}
