@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <img src="~/img/Logo.png" width="320px"/>
</div>
<div class="container text-center">
    <div class="row">
        @if (User.IsInRole("Administrador"))
        {
            <div class="col-sm-3">
                <a href="~/Juegos/Index" class="btn btn-outline-dark">Ver juegos</a>
            </div>
            <div class="col-sm-3">
                <a href="~/CategoriaJuegos/Index" class="btn btn-outline-dark">Ver categorías de juego</a>
            </div>
            <div class="col-sm-3">
                <a href="~/Reportes" class="btn btn-outline-dark">Reportes de tienda</a>
            </div>
            <div class="col-sm-3">
                <a href="~/Roles" class="btn btn-outline-dark">Asignar roles</a>
            </div>
        }
        else
        {
            <div class="col-sm-5 col-md-6">
                <button type="button" class="btn btn-outline-dark">Alquilar nuevo juego</button>
            </div>
            <div class="col-sm-5 col-md-6">
                <button type="button" class="btn btn-outline-dark">Ver historial de transacciones</button>
            </div>
        }
    </div>
</div>