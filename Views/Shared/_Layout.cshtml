@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@{
	var sesion = await Context.AuthenticateAsync(IdentityConstants.ApplicationScheme);
	var autenticado = sesion.Succeeded;
	var usuario = sesion.Principal;
	var fotoPerfil = usuario?.FindFirst("urn:google:picture")?.Value;
	var esAdmin = usuario?.IsInRole("Administrador") ?? false;
}
<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Ludoteca</title>
	<script type="importmap"></script>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/TPLudoteca.styles.css" asp-append-version="true" />
</head>
<body class="@(autenticado ? "" : "sin-sesion")">
	@if (autenticado)
	{
	<header>
		<nav class="navbar navbar-expand-lg navbar-dark sticky-top bg-dark">
			<div class="container-fluid">
				<a class="navbar-brand text-light" asp-area="" asp-controller="Home" asp-action="Index">
					<i class="bi bi-controller"></i>
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNavAltMarkup">
					<div class="navbar-nav">
						<a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
					</div>
					<div class="dropdown ms-auto">
						<button class="btn btn-link p-0 border-0 text-light dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de usuario">
							@if (!string.IsNullOrEmpty(fotoPerfil))
							{
								<img src="@fotoPerfil" alt="" class="avatar" referrerpolicy="no-referrer" />
							}
							else
							{
								<i class="bi bi-person-circle avatar-icono"></i>
							}
						</button>
						<ul class="dropdown-menu dropdown-menu-end shadow">
							<li><h6 class="dropdown-header">@usuario?.Identity?.Name</h6></li>
							@if (esAdmin)
							{
								<li><a class="dropdown-item" href="~/Juegos/Create"><i class="bi bi-plus-circle me-2"></i>Agregar nuevo juego</a></li>
								<li><a class="dropdown-item" href="~/CategoriaJuegos/Create"><i class="bi bi-plus-circle me-2"></i>Agregar nueva categoría de juego</a></li>
								<li><a class="dropdown-item" href="~/Reportes"><i class="bi bi-bar-chart me-2"></i>Reportes tienda</a></li>
								<li><a class="dropdown-item" href="~/Roles"><i class="bi bi-people me-2"></i>Asignación de roles</a></li>
								<li><hr class="dropdown-divider" /></li>
							}
							<li>
								<form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
									<button type="submit" class="dropdown-item text-danger">
										<i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
									</button>
								</form>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</nav>
	</header>
	}
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	@if (autenticado)
	{
	<footer class="border-top footer text-light bg-dark">
		<div class="container">
			&copy; 2026 - TPLudoteca
		</div>
	</footer>
	}
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>