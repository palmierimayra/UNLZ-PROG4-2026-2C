@model TPLudoteca.Models.UsuarioRolVM
@{
    ViewData["Title"] = "Asignar rol";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card manage-card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 fw-bold mb-1"><i class="bi bi-person-gear me-2"></i>Asignar rol</h1>
                <p class="text-secondary mb-4">Elegí el rol que va a tener este usuario.</p>

                <form asp-action="Editar" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="IdUsuario" />
                    <input type="hidden" asp-for="Email" />

                    <div class="form-floating mb-3">
                        <input value="@Model.Email" class="form-control" placeholder="Email" disabled />
                        <label><i class="bi bi-envelope me-1"></i> Email</label>
                    </div>

                    <div class="form-floating mb-4">
                        <select asp-for="Rol" asp-items="Model.RolesDisponibles" class="form-select">
                            <option value="">Elegí un rol</option>
                        </select>
                        <label asp-for="Rol"></label>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-dark w-50">Cancelar</a>
                        <button type="submit" class="btn btn-dark w-50">
                            <i class="bi bi-check2 me-1"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
