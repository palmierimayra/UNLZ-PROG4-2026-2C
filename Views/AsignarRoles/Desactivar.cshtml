@model TPLudoteca.Models.UsuarioRolVM
@{
    ViewData["Title"] = "Desactivar usuario";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card manage-card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 fw-bold mb-1"><i class="bi bi-person-slash me-2"></i>Desactivar usuario</h1>
                <p class="text-secondary mb-4">¿Seguro que querés desactivar este usuario?</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <dl class="row mb-3">
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Rol</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Rol) ? "Sin rol" : Model.Rol)</dd>
                </dl>

                <div class="alert alert-info small" role="alert">
                    <i class="bi bi-info-circle me-1"></i>
                    El usuario no va a poder iniciar sesión, pero sus datos y su historial de alquileres se conservan. Lo podés reactivar cuando quieras desde el listado.
                </div>

                <form asp-action="Desactivar" asp-route-id="@Model.IdUsuario" method="post">
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-dark w-50">Cancelar</a>
                        <button type="submit" class="btn btn-danger w-50">
                            <i class="bi bi-person-slash me-1"></i> Desactivar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
