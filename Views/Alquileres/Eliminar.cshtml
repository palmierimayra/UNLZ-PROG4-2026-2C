@model TPLudoteca.Models.AlquilerVM
@{
    ViewData["Title"] = "Eliminar alquiler";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card manage-card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 fw-bold mb-1"><i class="bi bi-trash me-2"></i>Eliminar alquiler</h1>
                <p class="text-secondary mb-4">¿Seguro que querés eliminar este alquiler?</p>

                <dl class="row mb-3">
                    <dt class="col-sm-6">Juego</dt>
                    <dd class="col-sm-6">@Model.JuegoVM?.DescripcionJuego</dd>

                    <dt class="col-sm-6">Fecha de retiro</dt>
                    <dd class="col-sm-6">@Model.FechaRetiro.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-6">Devolución estimada</dt>
                    <dd class="col-sm-6">@Model.FechaDevolucionEstimada.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-6">Monto</dt>
                    <dd class="col-sm-6">$ @Model.MontoTotal.ToString("N2")</dd>
                </dl>

                <div class="alert alert-info small" role="alert">
                    <i class="bi bi-info-circle me-1"></i>
                    El juego vuelve a quedar disponible para otros socios.
                </div>

                <form asp-action="Eliminar" asp-route-id="@Model.IdAlquiler" method="post">
                    <input type="hidden" asp-for="IdAlquiler" />
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-dark w-50">Cancelar</a>
                        <button type="submit" class="btn btn-danger w-50">
                            <i class="bi bi-trash me-1"></i> Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
